{
  "version": 1,
  "author": "Luca Enna",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-arduino-nano",
      "id": "nano",
      "top": 40,
      "left": 30
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": 30,
      "left": 300,
      "attrs": {
        "pins": "i2c",
        "i2cAddress": "0x27",
        "background": "blue",
        "color": "white"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "button",
      "top": 180,
      "left": 330,
      "attrs": {
        "color": "green",
        "label": "DRINK"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 190,
      "left": 100,
      "attrs": {
        "volume": "0.1"
      }
    }
  ],
  "connections": [
    ["nano:5V", "lcd:VCC", "red", []],
    ["nano:GND.1", "lcd:GND", "black", []],
    ["nano:A4", "lcd:SDA", "green", []],
    ["nano:A5", "lcd:SCL", "blue", []],
    ["nano:D2", "button:1.l", "green", []],
    ["nano:GND.2", "button:2.l", "black", []],
    ["nano:D8", "buzzer:1", "purple", []],
    ["nano:GND.3", "buzzer:2", "black", []]
  ],
  "serialMonitor": {
    "display": "auto",
    "newline": "lf"
  }
}